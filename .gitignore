# macOS
.DS_Store

# Harness caches (pinned host checkout, fetched sdist, per-run data folders)
.cache/

# Python
__pycache__/
*.pyc
.venv/

# Tooling caches
.pytest_cache/
.ruff_cache/

# NOTE: evidence/ is NOT ignored — the normalized evidence bundle
# (manifest.json + REPORT.md) is committed per D-09; raw pytest output is not.

# gsd-tools generated state cache (durable form is .planning/STATE.md)
.planning/state.json

# Stray host runtime artifacts (auth key written at import-time relative to cwd)
data/

# Playwright E2E (tests/e2e)
tests/e2e/node_modules/
tests/e2e/.seed.json
tests/e2e/test-results/
tests/e2e/playwright-report/

# conformance run logs (raw output is never committed — JSON reports only)
evidence/conformance/*.log
dist/
